meta {
  name: Verify Circuit And Fallback Calls
  type: http
  seq: 13
}

get {
  url: {{providerMockUrl}}/admin/calls
  body: none
  auth: none
}
tests {
  test("fourth checkout does not call broken hold endpoint", function() {
    expect(res.status).to.equal(200);
    expect(res.body["server-error:availability"]).to.equal(4);
    expect(res.body["server-error:hold"]).to.equal(3);
    expect(res.body["success:hold"]).to.equal(4);
  });
}
