meta {
  name: Assign Failing Primary Offer
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/internal/v1/products/{{externalProductId}}/providers/{{failingProviderId}}/inventory
  body: json
  auth: none
}

headers {
