}
body:json {
  {"on_hand": 99, "allocation_priority": 10, "routing_group": "0191f4b8-7d4a-7000-8000-000000000099"}
}
tests {
  test("failing primary assigned to fallback group", function() { expect(res.status).to.equal(200); });
}
