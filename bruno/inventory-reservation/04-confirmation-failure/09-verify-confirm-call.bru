meta {
  name: Verify Confirmation Endpoint Was Called
  type: http
  seq: 9
}

get {
  url: {{providerMockUrl}}/admin/calls
  body: none
  auth: none
}
tests {
  test("provider received hold and confirmation calls", function() {
    expect(res.status).to.equal(200);
    expect(res.body["confirm-timeout:hold"]).to.equal(1);
    expect(res.body["confirm-timeout:confirm"]).to.be.at.least(1);
  });
}
