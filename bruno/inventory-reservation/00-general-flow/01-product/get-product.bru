meta {
  name: Get Product
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/internal/v1/products/{{productId}}
  body: none
  auth: none
}

tests {
  test("created product is retrievable", function() {
    expect(res.status).to.equal(200);
    expect(res.body.id).to.equal(bru.getVar("productId"));
    expect(res.body.is_active).to.equal(true);
  });
}
