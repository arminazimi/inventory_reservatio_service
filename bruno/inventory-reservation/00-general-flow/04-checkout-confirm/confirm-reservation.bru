meta {
  name: Confirm Reservation After Payment
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/v1/reservations/{{reservationId}}/confirm
  body: none
  auth: none
}

headers {
  X-User-ID: {{userId}}
}

tests {
  test("reservation is confirmed", function() {
    expect(res.status).to.equal(200);
    expect(res.body.status).to.equal("confirmed");
  });
}
