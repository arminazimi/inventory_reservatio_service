meta {
  name: Verify Selected Seller Hold
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/internal/v1/products/{{productId}}/providers/{{sellerProviderId}}/inventory
  body: none
  auth: none
}

tests {
  test("two selected seller units are held", function() {
    expect(res.status).to.equal(200);
    expect(res.body.on_hand).to.equal(3);
    expect(res.body.reserved).to.equal(2);
    expect(res.body.available).to.equal(1);
  });
}
