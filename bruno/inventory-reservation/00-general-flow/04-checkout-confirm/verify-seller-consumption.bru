meta {
  name: Verify Selected Seller Stock Is Consumed
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/internal/v1/products/{{productId}}/providers/{{sellerProviderId}}/inventory
  body: none
  auth: none
}

tests {
  test("confirmed units leave seller inventory", function() {
    expect(res.status).to.equal(200);
    expect(res.body.on_hand).to.equal(1);
    expect(res.body.reserved).to.equal(0);
    expect(res.body.available).to.equal(1);
  });
}
