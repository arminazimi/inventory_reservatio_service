meta {
  name: Assign Marketplace Seller Offer
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/internal/v1/products/{{productId}}/providers/{{sellerProviderId}}/inventory
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "on_hand": 3,
    "allocation_priority": 20
  }
}

tests {
  test("seller offer has three available units", function() {
    expect(res.status).to.equal(200);
    expect(res.body.provider_id).to.equal(bru.getVar("sellerProviderId"));
    expect(res.body.on_hand).to.equal(3);
    expect(res.body.reserved).to.equal(0);
    expect(res.body.available).to.equal(3);
  });
}
