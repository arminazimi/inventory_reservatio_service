meta {
  name: List Product Offers
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/internal/v1/products/{{productId}}/inventory
  body: none
  auth: none
}

tests {
  test("product exposes two selectable offers", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.be.an("array").with.lengthOf(2);
    expect(res.body.map((offer) => offer.provider_id)).to.include.members([
      bru.getVar("internalProviderId"),
      bru.getVar("sellerProviderId")
    ]);
  });
}
