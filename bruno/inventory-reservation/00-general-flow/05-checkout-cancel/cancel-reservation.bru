meta {
  name: Cancel Reservation
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/reservations/{{cancelReservationId}}/cancel
  body: none
  auth: none
}

headers {
  X-User-ID: {{userId}}
}

tests {
  test("reservation is cancelled", function() {
    expect(res.status).to.equal(200);
    expect(res.body.status).to.equal("cancelled");
  });
}
