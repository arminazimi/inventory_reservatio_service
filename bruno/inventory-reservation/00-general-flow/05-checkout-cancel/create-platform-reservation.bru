meta {
  name: Reserve Platform Offer
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/reservations
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-User-ID: {{userId}}
  Idempotency-Key: checkout-cancel-001
}

body:json {
  {
    "items": [
      {
        "product_id": "{{productId}}",
        "provider_id": "{{internalProviderId}}",
        "quantity": 2
      }
    ]
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("cancelReservationId", res.body.id);
  }
}

tests {
  test("platform reservation is pending", function() {
    expect(res.status).to.equal(201);
    expect(res.body.status).to.equal("pending");
    expect(res.body.items[0].provider_id).to.equal(bru.getVar("internalProviderId"));
  });
}
