meta {
  name: Enable Platform Warehouse Provider
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/internal/v1/providers/{{internalProviderId}}/enable
  body: none
  auth: none
}

tests {
  test("platform provider is enabled", function() {
    expect(res.status).to.equal(200);
    expect(res.body.id).to.equal(bru.getVar("internalProviderId"));
    expect(res.body.is_enabled).to.equal(true);
  });
}
