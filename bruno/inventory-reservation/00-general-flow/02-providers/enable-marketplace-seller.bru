meta {
  name: Enable Marketplace Seller
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/internal/v1/providers/{{sellerProviderId}}/enable
  body: none
  auth: none
}

tests {
  test("marketplace seller is enabled", function() {
    expect(res.status).to.equal(200);
    expect(res.body.id).to.equal(bru.getVar("sellerProviderId"));
    expect(res.body.is_enabled).to.equal(true);
  });
}
