meta {
  name: Create External Demo Product
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/internal/v1/products
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "sku": "BRUNO-EXTERNAL-SUCCESS",
    "name": "Bruno External Hold Success Product"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("externalProductId", res.body.id);
  }
}

tests {
  test("external demo product is created", function() {
    expect(res.status).to.equal(201);
  });
}
