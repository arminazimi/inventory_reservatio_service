meta {
  name: Create Success Provider
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/internal/v1/providers
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "bruno-external-success",
    "kind": "external",
    "driver": "http",
    "base_url": "http://external-provider-mock:9000/scenarios/success",
    "request_timeout_ms": 300,
    "capabilities": {"availability": true, "hold": true, "confirm": true, "release": true}
  }
}

script:post-response {
  if (res.status === 201) bru.setVar("successProviderId", res.body.id);
}

tests {
  test("success provider is registered", function() {
    expect(res.status).to.equal(201);
    expect(res.body.kind).to.equal("external");
  });
}
