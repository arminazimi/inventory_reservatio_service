meta {
  name: Verify Stale Read Followed By Hold
  type: http
  seq: 7
}

get {
  url: {{providerMockUrl}}/admin/calls
  body: none
  auth: none
}
tests {
  test("stale availability was not trusted as authoritative", function() {
    expect(res.status).to.equal(200);
    expect(res.body["stale:availability"]).to.equal(1);
    expect(res.body["stale:hold"]).to.equal(1);
  });
}
