APP_NAME=Inventory Reservation Service
APP_ENV=local
DEBUG=true
LOG_LEVEL=INFO
API_PREFIX=/v1
API_PORT=8000

POSTGRES_DB=inventory
POSTGRES_USER=inventory
POSTGRES_PASSWORD=inventory
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://inventory:inventory@localhost:5432/inventory

RESERVATION_TTL_SECONDS=900
PROVIDER_FAILURE_THRESHOLD=3
PROVIDER_RECOVERY_TIMEOUT_SECONDS=30

EXPIRATION_BATCH_SIZE=100
EXPIRATION_POLL_INTERVAL_SECONDS=5
EXPIRATION_METRICS_HOST=0.0.0.0
EXPIRATION_METRICS_PORT=9101

RECONCILIATION_BATCH_SIZE=100
RECONCILIATION_MAX_ATTEMPTS=3
RECONCILIATION_POLL_INTERVAL_SECONDS=5
RECONCILIATION_RETRY_BASE_DELAY_SECONDS=30
RECONCILIATION_METRICS_HOST=0.0.0.0
RECONCILIATION_METRICS_PORT=9102
